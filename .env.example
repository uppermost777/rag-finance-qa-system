# ===== 应用 =====
APP_NAME=finance-qa
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_DIR=logs
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== MySQL 8.0 =====
# 异步驱动 aiomysql；Celery worker 内部使用同步驱动 pymysql（见 SYNC_DATABASE_URL）
DATABASE_URL=mysql+aiomysql://finance:finance_pwd@127.0.0.1:3306/finance_qa?charset=utf8mb4
SYNC_DATABASE_URL=mysql+pymysql://finance:finance_pwd@127.0.0.1:3306/finance_qa?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== Milvus 2.4 =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 本地嵌入式模式：填文件路径（如 work_logs/milvus.db）即可免服务端运行；留空则连接上面的 host:port
# 注意不要写成 MILVUS_URI（pymilvus 自身占用该环境变量）
MILVUS_LITE_PATH=
MILVUS_COLLECTION=finance_chunks
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_TIMEOUT=10

# ===== Redis 7 =====
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=50

# ===== 大模型（OpenAI 兼容接口：DeepSeek / 通义千问等）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-please-replace-me
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=600

# ===== 本地模型路径（bge-m3 / bge-reranker-v2-m3，运行时挂载 /models 卷）=====
EMBEDDING_MODEL_PATH=/models/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL_PATH=/models/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=8

# ===== 检索参数 =====
RECALL_TOP_K=10
RERANK_TOP_N=5
RRF_K=60
BM25_TOP_K=10
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_RERANK_SCORE=0.05
DEFAULT_STRATEGY=hybrid_rerank

# ===== 鉴权 =====
JWT_SECRET=please-change-this-to-a-random-64-chars-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== 上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=["pdf","docx","txt","md","html"]

# ===== 开关 =====
ENABLE_ANSWER_CACHE=false
RATE_LIMIT_PER_MINUTE=20
# 开发/演示：无 Celery/Redis 时在 API 进程内异步执行文档入库（生产务必保持 false）
INLINE_INGEST=false

# ===== Celery =====
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_QUEUE=finance_qa

# ===== docker-compose 专用（仅容器编排需要；本地开发可忽略）=====
# 这些变量被 docker-compose.yml 引用，请务必改成强密码后再启动容器
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=finance_qa
MYSQL_USER=finance
MYSQL_PASSWORD=change-me-db-password
MYSQL_PORT=3306
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-minio-password
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
APP_PORT=8000
NGINX_PORT=80

